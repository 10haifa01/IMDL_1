<?xml version="1.0"?>
<robot name="create3_sensors" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include official Create 3 base model -->
  <xacro:include filename="$(find irobot_create_description)/urdf/create3.urdf.xacro" />

  <xacro:property name="mm" value="0.001"/>

  <!-- MEASUREMENTS FROM FUSION -->
  <xacro:property name="lidar_x" value="0.497"/>    
  <xacro:property name="lidar_z" value="199.83"/>   
  <xacro:property name="cam_x"   value="205.697"/>    
  <xacro:property name="cam_y"   value="0.0"/>    
  <xacro:property name="cam_z"   value="63.83"/>    
  <xacro:property name="cam_tilt_deg" value="0.0"/>  

  <!-- Mounts -->
  <link name="lidar_camera_mounts_link">
    <visual>
      <geometry>
        <mesh filename="package://robot_description/meshes/lidar_camera_mounts.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="mount_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
  </link>
  <joint name="lidar_camera_mounts_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_camera_mounts_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR LINK -->
  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/lidar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="lidar_dark"><color rgba="0.2 0.2 0.2 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.11"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00008"/>
    </inertial>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="lidar_link"/>
    <origin xyz="${lidar_x*mm} 0 ${lidar_z*mm}" rpy="0 0 ${pi}"/>
  </joint>

  <!-- Gazebo Ray Sensor Plugin for LiDAR -->
  <gazebo reference="lidar_link">
    <material>Gazebo/DarkGrey</material>
    <sensor type="ray" name="lidar_sensor">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.28</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Camera: official D455 model -->
  <xacro:arg name="sim" default="true"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d455.urdf.xacro"/>
  <xacro:sensor_d455 parent="base_link" name="camera" use_nominal_extrinsics="$(arg sim)">
    <origin xyz="${cam_x*mm} ${cam_y*mm} ${cam_z*mm}" rpy="0 ${cam_tilt_deg*pi/180} 0"/>
  </xacro:sensor_d455>

</robot>